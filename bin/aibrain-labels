#!/usr/bin/env python3
"""Converge a project's GitHub labels from docs/agents/labels.json."""

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys


def command(args, directory):
    result = subprocess.run(args, cwd=directory, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"{args[0]} exited {result.returncode}")
    return result.stdout


def definitions(path):
    labels = json.loads(path.read_text())
    if not isinstance(labels, list):
        raise ValueError("labels.json must contain an array of label definitions")
    names, roles = set(), set()
    for label in labels:
        if not isinstance(label, dict) or any(
            not isinstance(label.get(key), str)
            for key in ("role", "name", "color", "description")
        ):
            raise ValueError("each label needs string role, name, color and description fields")
        name, role = label["name"], label["role"]
        if not name or name != name.strip() or not name.isprintable():
            raise ValueError("label names must be nonempty printable text without surrounding spaces")
        if not re.fullmatch(r"[a-z][a-z0-9-]*", role):
            raise ValueError(f"invalid label role: {role!r}")
        if name.casefold() in names or role in roles:
            raise ValueError("label names and roles must be unique")
        if not re.fullmatch(r"[0-9a-fA-F]{6}", label["color"]):
            raise ValueError(f"invalid color for label {name!r}")
        names.add(name.casefold())
        roles.add(role)
    return labels


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("project", nargs="?", type=Path, default=Path.cwd())
    parser.add_argument("--check", action="store_true", help="report differences without writing")
    args = parser.parse_args()
    project = args.project.resolve()
    config = project / "docs/agents/labels.json"
    if not config.is_file():
        return 0
    wanted = definitions(config)
    if not wanted:
        return 0
    remote = command(["git", "remote", "get-url", "origin"], project).strip()
    match = re.fullmatch(
        r"(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)"
        r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/?", remote
    )
    if not match:
        print(f"{project.name}: skipping labels for a non-GitHub origin")
        return 0
    repo = match[1].removesuffix(".git")
    pages = json.loads(command(
        ["gh", "api", "--paginate", "--slurp", f"repos/{repo}/labels?per_page=100"], project
    ))
    if not isinstance(pages, list) or any(not isinstance(page, list) for page in pages):
        raise ValueError("GitHub returned an unexpected label list")
    existing = {label["name"].casefold(): label for page in pages for label in page}
    changed = 0
    for label in wanted:
        current = existing.get(label["name"].casefold())
        if current and current["color"].lower() == label["color"].lower() and (
            current.get("description") or ""
        ) == label["description"]:
            continue
        changed += 1
        if args.check:
            print(f"{repo}: label needs synchronization: {label['name']}")
        else:
            command([
                "gh", "label", "create", "--repo", repo, "--force",
                "--color", label["color"], "--description", label["description"],
                "--", label["name"],
            ], project)
            print(f"{repo}: synchronized label {label['name']}")
    if not changed:
        print(f"{repo}: all {len(wanted)} configured labels already match")
    return int(args.check and changed > 0)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError) as error:
        print(f"aibrain-labels: {error}", file=sys.stderr)
        sys.exit(1)
